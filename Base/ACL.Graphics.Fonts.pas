{ TACLFontRepository }

class constructor TACLFontRepository.Create;
begin
  FLock := TACLCriticalSection.Create;
  FFonts := TACLStringSet.Create(False, 512);
end;

class destructor TACLFontRepository.Destroy;
begin
  TACLMainThread.Unsubscribe(StartLoaderCore);
  WaitForLoader(True);
  if FFontsToDelete <> nil then
  try
    acDeleteFiles(FFontsToDelete);
  finally
    FreeAndNil(FFontsToDelete);
  end;
  FreeAndNil(FFonts);
  FreeAndNil(FLock);
end;

class procedure TACLFontRepository.AsyncFontLoader(ACheckCanceled: TACLTaskCancelCallback);
var
  LData: TCallbackData;
  LDC: HDC;
  LFont: TLogFont;
begin
  try
    LDC := CreateCompatibleDC(0);
    try
      LData.CheckCanceled := ACheckCanceled;
      FillChar(LFont{%H-}, SizeOf(LFont), #0);
      LFont.lfCharset := DEFAULT_CHARSET;
      EnumFontFamiliesEx(LDC, {$IFDEF FPC}@{$ENDIF}LFont, @AsyncFontLoaderEnumProc, {%H-}LPARAM(@LData), 0);
    finally
      DeleteDC(LDC);
    end;
  finally
    FLoaderHandle := TObjHandle(-1);
    LogEntry(acGeneralLogFileName, 'Fonts', 'Loader Finished');
  end;
end;

class function TACLFontRepository.AsyncFontLoaderEnumProc(var ALogFont: TLogFont;
  ATextMetric: PTextMetric; AFontType: Integer; AData: PCallbackData): Integer;
begin
  if AFontType <> RASTER_FONTTYPE then
  begin
    if ALogFont.lfFaceName[0] <> '@' then // vertical;
      FFonts.Include(ALogFont.lfFaceName);
  end;
  Result := IfThen(Assigned(AData.CheckCanceled) and AData.CheckCanceled, 0, 1);
end;

class function TACLFontRepository.Enumerate: IACLEnumerable<string>;
begin
  WaitForLoader;
  Result := TACLLockedEnumerable<string>.Create(FFonts, FLock);
end;

class procedure TACLFontRepository.FlushCache;
begin
  LogEntry(acGeneralLogFileName, 'Fonts', 'FlushCache');
{$IFDEF LINUX}
  TACLProcess.Execute('fc-cache -f');
{$ENDIF}
end;

class function TACLFontRepository.RegisterCustomFont(
  AData: TMemoryStream; out AName: string): TObject;
var
{$IFDEF LINUX}
  LAppId: string;
  LPath: string;
{$ENDIF}
  LList: TACLObjectList;
begin
  Result := nil;
  AName := acGetTrueTypeFontName(AData);
  if AName = '' then Exit;
{$IFDEF MSWINDOWS}
  var LCount: LongWord := 0;
  var LHandle := AddFontMemResourceEx(AData.Memory, AData.Size, nil, @LCount);
  if (LHandle = 0) or (LCount = 0) then
    LogEntry(acGeneralLogFileName, 'Fonts', 'RegisterFont(%s) failed', [AName]);
  if LHandle <> 0 then
  begin
    TMemoryFontHandle(Result) := TMemoryFontHandle.Create;
    TMemoryFontHandle(Result).FHandle := LHandle;
  end;
{$ELSEIF DEFINED(LINUX)}
  // TODO: FT_New_Memory_Face
  LAppId := acChangeFileExt(acExtractFileName(Paramstr(0)), '');
  LPath := acIncludeTrailingPathDelimiter(GetUserDir) + '.local/share/fonts/ttf/' + LAppId + '/';
  if ForceDirectories(LPath) then
  begin
    LPath := LPath + TACLHashMD5.Calculate(AData) + '.ttf';
    try
      AData.SaveToFile(LPath);
      if FFontsToDelete = nil then
        FFontsToDelete := TACLStringList.Create;
      FFontsToDelete.Add(LPath);
    except
      on E: Exception do
      begin
        DeleteFile(LPath);
        LogEntry(acGeneralLogFileName, 'Fonts', 'RegisterFont(%s: %s) failed', [AName, E.Message]);
      end;
    end;
  end;
{$ENDIF}
end;

class procedure TACLFontRepository.StartLoader;
begin
  if FLoaderHandle = 0 then
    TACLMainThread.RunPostponed(StartLoaderCore);
end;

class procedure TACLFontRepository.StartLoaderCore;
begin
  if FLoaderHandle = 0 then
  begin
  {$IFDEF MSWINDOWS}
    FLoaderHandle := TaskDispatcher.Run(AsyncFontLoader);
  {$ELSE}
    AsyncFontLoader(nil); // LCL API is not thread-safe
  {$ENDIF}
  end;
end;

class procedure TACLFontRepository.WaitForLoader(ACancel: Boolean);
begin
  if FLoaderHandle = 0 then
  begin
    if ACancel then Exit;
    StartLoaderCore;
  end;
  if FLoaderHandle <> TObjHandle(-1) then
  begin
    if ACancel then
      TaskDispatcher.Cancel(FLoaderHandle, True)
    else
      TaskDispatcher.WaitFor(FLoaderHandle);
  end;
end;

end.
